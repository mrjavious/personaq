# Persona Studio (personaq) - Environment Configuration

# Database
# Local SQLite default: "file:./dev.db"
# Postgres (via Docker): "postgresql://personaq:personaq_dev_password@localhost:5432/personaq_db?schema=public"
DATABASE_URL="file:./dev.db"

# Session & Auth
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate_with_openssl_rand_base64_32"
AUTH_REQUIRE_2FA=true

# Queue & Cache (BullMQ / Redis)
REDIS_URL="redis://localhost:6379"

# Object Storage (MinIO local or Cloudflare R2 prod)
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY="your_minio_access_key"
STORAGE_SECRET_KEY="your_minio_secret_key"
STORAGE_BUCKET="personaq-assets"
STORAGE_PUBLIC_URL="http://localhost:9000/personaq-assets"

# AI Text Providers
GEMINI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# AI Image Orchestration (ComfyUI local HTTP API)
COMFYUI_API_URL="http://127.0.0.1:8188"

# Platform API Credentials (Phase 4)
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
X_API_KEY=""
X_API_SECRET=""
THREADS_APP_ID=""
THREADS_APP_SECRET=""

# Secret Encryption Key (32-byte hex for AES-256-GCM tokens encryption)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="generate_with_openssl_rand_hex_32"
